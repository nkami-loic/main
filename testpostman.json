            },
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": ["{{baseUrl}}"],
              "path": ["matches"]
            }
          }
        },
        {
          "name": "Get All Matches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": ["{{baseUrl}}"],
              "path": ["matches"]
            }
          }
        },
        {
          "name": "Get Match by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/matches/1",
              "host": ["{{baseUrl}}"],
              "path": ["matches", "1"]
