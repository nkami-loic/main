        },
        {
          "name": "Update Match Score",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"player1_score\": \"6-4, 6-3\",\n  \"player2_score\": \"4-6, 3-6\",\n  \"winner_id\": 2,\n  \"status\": \"completed\"\n}"
            },
            "url": {
